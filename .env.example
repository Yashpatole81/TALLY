# Copy to `.env` and fill in from Supabase → Project Settings → API.
# Only the PUBLISHABLE (or legacy anon) key belongs in the app. RLS protects the data.
# Never put the secret / service_role key here: everything prefixed EXPO_PUBLIC_ ships in the app bundle.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
